# ============================================================
#  Secrets and customer data — never in git
# ============================================================
# config.php holds the SMTP password and link_secret in clear text.
# Once a secret is committed it is in the history for good, even if the next
# commit removes it, so it is excluded rather than cleaned up later.
config.php

# Written by the site: Khalid's password hash, every valuation, every support
# message, the mail log. None of it belongs in a code repository.
data/
uploads/

# ============================================================
#  Deployment leftovers
# ============================================================
*.zip
public_html/
*.bak
*.orig
.DS_Store
Thumbs.db

# ============================================================
#  Flutter app
# ============================================================
# Generated by app/tool/bootstrap.sh from whichever Flutter is building.
# See that script for why they are not committed.
app/android/
app/ios/
app/linux/
app/macos/
app/windows/
app/web/

app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/out/
app/pubspec.lock
app/.packages

# The signing key and its passwords. CI writes both from repository secrets.
# If this key is lost, the app on Play can never be updated again — keep the
# original somewhere safe and offline, not here.
*.jks
*.keystore
key.properties
